# Server
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/medical-platform

# Authentication (replace this example value with a long random secret locally)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h

# Client origins (comma separated)
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
